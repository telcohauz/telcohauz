# Copy to .env locally. Configure deployment values in the platform secret store.
# Confirm the intended Supabase project before supplying matching URL and key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix a privileged key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional deployed module URLs. Leave blank until each module passes acceptance.
VITE_BOZ_BUSINESS_URL=
VITE_BOZ_AUDIT_URL=
VITE_BOZ_MAP_URL=
